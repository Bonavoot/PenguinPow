{
  "name": "penguin-pow",
  "version": "1.0.0",
  "description": "PenguinPow Game",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dev": "vite",
    "build": "vite build",
    "build:client": "cd client && npm run build",
    "build:electron": "npm run build:client && electron-builder",
    "electron:build": "npm run build:client && electron-builder",
    "dev:client": "cd client && npm run dev",
    "dev:server": "cd server-io && npm run dev",
    "dev:game": "concurrently \"npm run dev:server\" \"npm run dev:client\" \"wait-on http://localhost:3001 http://localhost:5173 && npm start\"",
    "dev:web": "concurrently \"npm run dev:server\" \"npm run dev:client\"",
    "dev:full": "concurrently \"npm run dev:client\" \"wait-on http://localhost:5173 && npm start\"",
    "install:all": "npm install && cd client && npm install && cd ../server-io && npm install",
    "test": "npm run test --prefix server-io",
    "test:clinch": "npm run test:clinch --prefix server-io",
    "test:clinch:network": "npm run test:clinch:network --prefix server-io",
    "test:clinch:watch": "npm run test:clinch:watch --prefix server-io",
    "test:clinch:coverage": "npm run test:clinch:coverage --prefix server-io",
    "perf:baseline": "node client/scripts/perf/runPerfBaseline.mjs",
    "perf:inventory": "node client/scripts/perf/assetInventory.mjs",
    "perf:reachability": "node client/scripts/perf/reachabilityReport.mjs",
    "perf:loops": "node client/scripts/perf/liveLoopInventory.mjs",
    "perf:cosmetics": "node client/scripts/perf/validateCosmeticMappings.mjs",
    "perf:phase1": "node client/scripts/perf/phase1Regression.mjs",
    "perf:phase2": "node client/scripts/perf/phase2Regression.mjs",
    "perf:phase3": "node client/scripts/perf/phase3Regression.mjs",
    "perf:phase4": "node client/scripts/perf/phase4Regression.mjs",
    "perf:phase5": "node client/scripts/perf/phase5Regression.mjs",
    "perf:server-scaffold": "node server-io/scripts/roomLoadBaseline.mjs",
    "perf:server-load": "node server-io/scripts/roomLoadBaseline.mjs",
    "perf:server-soak": "node server-io/scripts/liveRoomSoak.mjs",
    "encode:display": "node client/scripts/encodeDisplayAssets.mjs"
  },
  "dependencies": {
    "react-player": "^2.15.1",
    "steamworks.js": "^0.4.0",
    "uuid": "^9.0.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.4.1",
    "concurrently": "^9.1.2",
    "electron": "^31.7.0",
    "electron-builder": "^25.1.8",
    "sharp": "^0.34.5",
    "vite": "^6.3.5",
    "wait-on": "^8.0.3"
  },
  "build": {
    "appId": "com.penguinpow.game",
    "productName": "PenguinPow",
    "asar": false,
    "directories": {
      "output": "dist"
    },
    "icon": "assets/icon.png",
    "files": [
      "main.js",
      "preload.js",
      "client/dist/**/*",
      "node_modules/steamworks.js/dist/**/*",
      "steam_appid.txt",
      "steam_input_config.vdf",
      "assets/**/*",
      "server-io/**/*",
      "!server-io/match-logs/**",
      "!server-io/scripts/**",
      "!server-io/test/**",
      "!server-io/**/*.md",
      "!server-io/package-lock.json",
      "!server-io/node_modules/**/README*",
      "!server-io/node_modules/**/readme*",
      "!server-io/node_modules/**/CHANGELOG*",
      "!server-io/node_modules/**/LICENSE*",
      "!server-io/node_modules/**/*.md",
      "!server-io/node_modules/**/test/**",
      "!server-io/node_modules/**/tests/**",
      "!server-io/node_modules/**/docs/**"
    ],
    "extraResources": [
      {
        "from": "node_modules/steamworks.js/dist",
        "to": ".",
        "filter": [
          "**/*"
        ]
      }
    ],
    "mac": {
      "category": "public.app-category.games"
    },
    "win": {
      "icon": "assets/icon.png",
      "sign": null,
      "verifyUpdateCodeSignature": false
    },
    "linux": {
      "target": "AppImage"
    }
  }
}
