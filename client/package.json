{
  "name": "client",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "bake": "node --no-warnings --loader ./scripts/extResolve.mjs scripts/bakeSprites.mjs",
    "bake:hats": "BAKE_HATS_ONLY=1 BAKE_MERGE=1 node --no-warnings --loader ./scripts/extResolve.mjs scripts/bakeSprites.mjs",
    "bake:pack": "node scripts/packBaked.mjs",
    "enhance:dohyo": "node scripts/enhance-dohyo.mjs",
    "bake:dohyo-display": "node scripts/bake-dohyo-display.mjs",
    "bake:dohyo": "npm run enhance:dohyo && npm run bake:dohyo-display && node scripts/measure-ice-clip.mjs --write",
    "encode:display": "node scripts/encodeDisplayAssets.mjs",
    "build": "node scripts/maybeBake.mjs && vite build",
    "lint": "eslint src --ext js,jsx --report-unused-disable-directives --max-warnings 0",
    "preview": "vite preview",
    "perf:baseline": "node scripts/perf/runPerfBaseline.mjs",
    "perf:cosmetics": "node scripts/perf/validateCosmeticMappings.mjs"
  },
  "dependencies": {
    "@fontsource/bungee": "^5.2.7",
    "@fontsource/noto-sans-jp": "^5.2.9",
    "@fontsource/noto-serif-jp": "^5.2.8",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-player": "^2.15.1",
    "react-router-dom": "^6.14.2",
    "socket.io-client": "^4.7.1",
    "styled-components": "^6.0.7",
    "uuid": "^9.0.0"
  },
  "devDependencies": {
    "@types/react": "^18.2.14",
    "@types/react-dom": "^18.2.6",
    "@vitejs/plugin-react": "^4.0.1",
    "eslint": "^8.44.0",
    "eslint-plugin-react": "^7.32.2",
    "eslint-plugin-react-hooks": "^4.6.0",
    "eslint-plugin-react-refresh": "^0.4.1",
    "pngjs": "^7.0.0",
    "sharp": "^0.35.2",
    "vite": "^4.4.0"
  }
}
